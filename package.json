{
  "name": "@jackery/design-system",
  "version": "0.1.0",
  "description": "Jackery Design System (JDS) - Monorepo",
  "author": "Jackery F2E Team",
  "type": "module",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@8.15.6",
  "repository": {
    "type": "git",
    "url": "http://192.168.30.241/global-website/jackery-design-system.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tooling/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "site:dev": "vite",
    "site:build": "vite build",
    "site:preview": "vite preview",
    "examples:dev": "pnpm -w --filter @jackery/examples dev",
    "examples:build": "pnpm -w --filter @jackery/examples build",
    "examples:preview": "pnpm -w --filter @jackery/examples preview",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "storybook": "turbo run storybook",
    "build-storybook": "turbo run build-storybook",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "changeset:status": "changeset status",
    "release": "pnpm run build && pnpm run changeset:publish",
    "version-packages": "pnpm run changeset:version && pnpm install --lockfile-only",
    "i18n:to-excel": "node packages/i18n/src/scripts/convert-to-excel.js",
    "i18n:to-json": "node packages/i18n/src/scripts/excel-to-json.js"
  },
  "keywords": [
    "web-components",
    "typescript",
    "lit"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@jackery/eslint-config": "workspace:*",
    "@jackery/tsconfig": "workspace:*",
    "@storybook/manager-api": "8.6.14",
    "@storybook/theming": "8.6.14",
    "@storybook/web-components": "8.6.14",
    "@storybook/web-components-vite": "8.6.14",
    "eslint": "^8.57.0",
    "exceljs": "^4.4.0",
    "less": "^4.4.2",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "tslib": "^2.8.1",
    "turbo": "^2.0.0",
    "typescript": "~5.8.3",
    "vite": "^5.4.11",
    "vite-plugin-compression": "^0.5.1"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.25.5",
    "@esbuild/win32-x64": "^0.25.5",
    "@rollup/rollup-linux-x64-gnu": "^4.44.0",
    "@rollup/rollup-win32-x64-msvc": "^4.44.0"
  }
}
