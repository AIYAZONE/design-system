{
  "name": "@jackery/design-system",
  "version": "0.1.0",
  "description": "Jackery Design System (JDS) - Monorepo",
  "author": "Jackery F2E Team",
  "type": "module",
  "private": false,
  "license": "MIT",
  "packageManager": "pnpm@8.15.6",
  "repository": {
    "type": "git",
    "url": "http://192.168.30.241/global-website/jackery-design-system.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tooling/*"
  ],
  "scripts": {
    "build": "turbo run build --filter=!@jackery/examples",
    "dev": "turbo run dev",
    "site:preview": "vite preview --strictPort --port 5175",
    "design:build:lib": "vite build --mode library",
    "postdesign:build:lib": "pnpm run types:bundle",
    "design:build": "pnpm run design:build:lib && pnpm run types:bundle && pnpm run design:build:themes",
    "design:build:single": "vite build --mode library-single",
    "design:build:themes": "vite build --mode themes",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "storybook": "turbo run storybook",
    "build-storybook": "turbo run build-storybook",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "changeset:status": "changeset status",
    "release": "pnpm run build && pnpm run changeset:publish",
    "publish": "pnpm run design:build && npm publish",
    "version-packages": "pnpm run changeset:version && pnpm install --lockfile-only",
    "i18n:to-excel": "node packages/i18n/src/scripts/convert-to-excel.js",
    "i18n:to-json": "node packages/i18n/src/scripts/excel-to-json.js",
    "types:bundle": "rollup -c scripts/build-types.rollup.config.mjs"
  },
  "keywords": [
    "web-components",
    "typescript",
    "lit"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.esm.js",
  "types": "./dist/jds.d.ts",
  "exports": {
    ".": {
      "types": "./dist/jds.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs"
    },
    "./index.css": "./dist/index.css",
    "./index-v2.css": "./dist/index-v2.css",
    "./themes-switch.css": "./dist/themes-switch.css"
  },
  "files": [
    "dist/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@jackery/eslint-config": "workspace:*",
    "@jackery/tsconfig": "workspace:*",
    "@open-wc/form-control": "^1.0.0",
    "eslint": "^8.57.0",
    "exceljs": "^4.4.0",
    "lit": "^3.3.1",
    "less": "^4.4.2",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "tslib": "^2.8.1",
    "turbo": "^2.6.0",
    "typescript": "~5.8.3",
    "vite": "^5.4.11",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-dts": "^3.9.1",
    "rollup": "^4.52.5",
    "@rollup/plugin-alias": "^5.1.1",
    "rollup-plugin-dts": "^6.2.3",
    "rollup-plugin-visualizer": "^6.0.5"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.25.5",
    "@esbuild/win32-x64": "^0.25.5",
    "@rollup/rollup-linux-x64-gnu": "^4.44.0",
    "@rollup/rollup-win32-x64-msvc": "^4.44.0"
  }

}
