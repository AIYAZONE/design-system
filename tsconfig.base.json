{
  "extends": "@aiyazone/tsconfig/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@": ["./src"],
      "@/*": ["./src/*"],
      "@styles": ["./src/styles"],
      "@styles/*": ["./src/styles/*"],
      "@aiyazone/design-system": ["./src/index.ts"],
      "@aiyazone/core": ["./packages/core/src"],
      "@aiyazone/core/*": ["./packages/core/src/*"],
      "@aiyazone/icons": ["./packages/icons/src"],
      "@aiyazone/icons/*": ["./packages/icons/src/*"],
      "@aiyazone/i18n": ["./packages/i18n/src"],
      "@aiyazone/i18n/*": ["./packages/i18n/src/*"],
      "@aiyazone/utils": ["./packages/utils/src"],
      "@aiyazone/utils/*": ["./packages/utils/src/*"]
    }
  },
  "references": [
    {
      "path": "./packages/core"
    },
    {
      "path": "./packages/icons"
    },
    {
      "path": "./packages/i18n"
    },
    {
      "path": "./packages/utils"
    },
    {
      "path": "./apps/storybook"
    }
  ]
}
