{
  "name": "@aiyazone/utils",
  "version": "0.1.0",
  "description": "AIYAZONE Design System - Utility Functions",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./common": {
      "import": "./dist/common.js",
      "require": "./dist/common.cjs",
      "types": "./dist/common.d.ts"
    },
    "./elements": {
      "import": "./dist/elements.js",
      "require": "./dist/elements.cjs",
      "types": "./dist/elements.d.ts"
    },
    "./event": {
      "import": "./dist/event.js",
      "require": "./dist/event.cjs",
      "types": "./dist/event.d.ts"
    },
    "./form-control": {
      "import": "./dist/form-control.js",
      "require": "./dist/form-control.cjs",
      "types": "./dist/form-control.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "vite build --watch",
    "lint": "eslint -c ../../tooling/eslint-config/index.cjs src --ext .ts,.tsx --quiet",
    "lint:verbose": "eslint -c ../../tooling/eslint-config/index.cjs src --ext .ts,.tsx",
    "lint:fix": "eslint -c ../../tooling/eslint-config/index.cjs src --ext .ts,.tsx --fix --quiet",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@open-wc/form-control": "^1.0.0"
  },
  "devDependencies": {
    "@aiyazone/eslint-config": "workspace:*",
    "@aiyazone/tsconfig": "workspace:*",
    "lit": "^3.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.3",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
