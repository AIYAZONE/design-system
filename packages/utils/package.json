{
  "name": "@jackery/utils",
  "version": "0.1.0",
  "description": "Jackery Design System - Utility Functions",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./common": {
      "import": "./dist/common.js",
      "require": "./dist/common.cjs",
      "types": "./dist/common.d.ts"
    },
    "./elements": {
      "import": "./dist/elements.js",
      "require": "./dist/elements.cjs",
      "types": "./dist/elements.d.ts"
    },
    "./event": {
      "import": "./dist/event.js",
      "require": "./dist/event.cjs",
      "types": "./dist/event.d.ts"
    },
    "./form-control": {
      "import": "./dist/form-control.js",
      "require": "./dist/form-control.cjs",
      "types": "./dist/form-control.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {},
  "devDependencies": {
    "@jackery/eslint-config": "workspace:*",
    "@jackery/tsconfig": "workspace:*",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "rimraf": "^5.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}