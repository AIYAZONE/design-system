{
  "name": "@jackery/i18n",
  "version": "0.1.1",
  "description": "Jackery Design System - Internationalization",
  "type": "module",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint -c ../../tooling/eslint-config/index.cjs src --ext .ts,.tsx --quiet",
    "lint:verbose": "eslint -c ../../tooling/eslint-config/index.cjs src --ext .ts,.tsx",
    "lint:fix": "eslint -c ../../tooling/eslint-config/index.cjs src --ext .ts,.tsx --fix --quiet",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "sideEffects": [
    "./src/index.ts",
    "./dist/*"
  ],
  "peerDependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@jackery/eslint-config": "workspace:*",
    "@jackery/tsconfig": "workspace:*",
    "lit": "^3.3.1",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.3",
    "vitest": "^1.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
