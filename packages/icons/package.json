{
  "name": "@aiyazone/icons",
  "type": "module",
  "version": "0.1.3",
  "description": "AIYAZONE Design System 图标库",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AIYAZONE/design-system.git"
  },
  "author": {
    "name": "AIYAZONE F2E Team"
  },
  "license": "MIT",
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "dev": "vite",
    "build": "tsc && vite build",
    "commit": "commit",
    "test": "vitest run"
  },
  "keywords": [
    "icons"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@commitlint/prompt-cli": "^19.6.0",
    "eslint": "^9.15.0",
    "vite": "^5.4.11",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-dts": "^3.7.3",
    "vite-plugin-static-copy": "^2.3.0",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "lit": "^3.2.1",
    "tslib": "^2.8.1"
  }
}
