{
  "name": "@jackery/icons",
  "version": "0.1.0",
  "description": "Jackery Design System - Icon Library",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./svg": "./dist/svg",
    "./fonts": "./dist/fonts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && npm run build:icons",
    "build:icons": "node scripts/build-icons.js",
    "dev": "vite build --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@jackery/eslint-config": "workspace:*",
    "@jackery/tsconfig": "workspace:*",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "rimraf": "^5.0.0",
    "svgo": "^3.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}