{
  "name": "@aiyazone/core",
  "version": "0.1.9",
  "description": "AIYAZONE Design System - Core Components",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "import": "./dist/button/index.js",
      "require": "./dist/button/index.cjs"
    },
    "./checkbox": {
      "types": "./dist/checkbox/index.d.ts",
      "import": "./dist/checkbox/index.js",
      "require": "./dist/checkbox/index.cjs"
    },
    "./badge": {
      "types": "./dist/badge/index.d.ts",
      "import": "./dist/badge/index.js",
      "require": "./dist/badge/index.cjs"
    },
    "./dialog": {
      "types": "./dist/dialog/index.d.ts",
      "import": "./dist/dialog/index.js",
      "require": "./dist/dialog/index.cjs"
    },
    "./dropdown": {
      "types": "./dist/dropdown/index.d.ts",
      "import": "./dist/dropdown/index.js",
      "require": "./dist/dropdown/index.cjs"
    },
    "./filter-select": {
      "types": "./dist/filter-select/index.d.ts",
      "import": "./dist/filter-select/index.js",
      "require": "./dist/filter-select/index.cjs"
    },
    "./popover": {
      "types": "./dist/popover/index.d.ts",
      "import": "./dist/popover/index.js",
      "require": "./dist/popover/index.cjs"
    },
    "./spinner": {
      "types": "./dist/spinner/index.d.ts",
      "import": "./dist/spinner/index.js",
      "require": "./dist/spinner/index.cjs"
    },
    "./toast": {
      "types": "./dist/toast/index.d.ts",
      "import": "./dist/toast/index.js",
      "require": "./dist/toast/index.cjs"
    },
    "./tooltip": {
      "types": "./dist/tooltip/index.d.ts",
      "import": "./dist/tooltip/index.js",
      "require": "./dist/tooltip/index.cjs"
    },
    "./styles": "./dist/styles/index.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && rollup -c ../../scripts/build-core-types.rollup.config.mjs",
    "dev": "vite build --watch",
    "manifest": "cem analyze --globs \"src/components/**/index.ts\" --exclude \"**/*.stories.ts\" --outdir .",
    "docs:gen": "node scripts/build-ai-docs.mjs",
    "docs:check": "pnpm run manifest && pnpm run docs:gen && git diff --exit-code -- zone-manifest.json ../../docs/api ../../docs/tokens ../../apps/portal/public/llms.txt ../../apps/portal/public/llms-full.txt ../../apps/portal/public/ai-usage.html",
    "lint": "eslint -c ../../tooling/eslint-config/index.cjs src --ext .ts,.tsx --quiet",
    "lint:verbose": "eslint -c ../../tooling/eslint-config/index.cjs src --ext .ts,.tsx",
    "lint:fix": "eslint -c ../../tooling/eslint-config/index.cjs src --ext .ts,.tsx --fix --quiet",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@aiyazone/i18n": "workspace:*",
    "@aiyazone/utils": "workspace:*",
    "@floating-ui/dom": "^1.7.4",
    "lit": "^3.3.1"
  },
  "devDependencies": {
    "@aiyazone/eslint-config": "workspace:*",
    "@aiyazone/tsconfig": "workspace:*",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@testing-library/dom": "^9.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.11.30",
    "@vitest/coverage-v8": "^3.2.7",
    "axe-core": "^4.7.0",
    "jsdom": "^27.4.0",
    "less": "^4.4.2",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.2.2",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": ["./src/components/**", "./src/index.ts", "./dist/**"],
  "customElements": "custom-elements.json"
}
