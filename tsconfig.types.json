{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@aiyazone/core": ["packages/core/src"],
      "@aiyazone/icons": ["packages/icons/src"],
      "@aiyazone/i18n": ["packages/i18n/src"],
      "@aiyazone/utils": ["packages/utils/src"]
    }
  },
  "include": [
    "src/**/*.ts",
    "packages/core/src/**/*.ts",
    "packages/icons/src/**/*.ts",
    "packages/i18n/src/**/*.ts",
    "packages/utils/src/**/*.ts"
  ]
}
