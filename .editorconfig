# EditorConfig 帮助开发人员定义和维护不同编辑器和 IDE 之间的一致的编码风格
# editorconfig.org
root = true

[*]
charset = utf-8          # 文件编码为 UTF-8
end_of_line = lf         # 行尾符为 LF（Unix 风格）
indent_size = 2          # 缩进大小为 2 个空格
indent_style = space     # 缩进风格为空格
insert_final_newline = true  # 文件末尾插入空行
max_line_length = 80     # 最大行长度为 80 个字符
trim_trailing_whitespace = true  # 去除行尾空白字符

[*.md]
trim_trailing_whitespace = false  # 对于 Markdown 文件，不去除行尾空白字符