{
  "extends": "@jackery/tsconfig/app.json",
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["vite/client"],
    "moduleResolution": "bundler",
    "paths": {
      "@": ["../../src"],
      "@/*": ["../../src/*"],
      "@styles": ["../../src/styles"],
      "@styles/*": ["../../src/styles/*"],
      "@jackery/design-system": ["../../src/register.ts"],
      "@jackery/core": ["../../packages/core/src"],
      "@jackery/core/*": ["../../packages/core/src/*"],
      "@jackery/icons": ["../../packages/icons/src"],
      "@jackery/icons/*": ["../../packages/icons/src/*"],
      "@jackery/i18n": ["../../packages/i18n/src"],
      "@jackery/i18n/*": ["../../packages/i18n/src/*"],
      "@jackery/utils": ["../../packages/utils/src"],
      "@jackery/utils/*": ["../../packages/utils/src/*"]
    }
  },
  "include": ["./**/*.ts", "./**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
