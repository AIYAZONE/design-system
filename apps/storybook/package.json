{
  "name": "@zone/storybook",
  "version": "0.1.1",
  "description": "AIYAZONE Design System - Storybook Documentation",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "storybook dev -p 6006 -c ../../.storybook",
    "storybook": "pnpm run dev",
    "build": "storybook build -c ../../.storybook",
    "build:storybook": "pnpm run build",
    "preview": "serve ./storybook-static",
    "chromatic": "npx chromatic --project-token=chpt_ab15977da40331a",
    "lint": "eslint -c ../../tooling/eslint-config/index.cjs ../../.storybook --ext .ts,.js --quiet",
    "lint:verbose": "eslint -c ../../tooling/eslint-config/index.cjs ../../.storybook --ext .ts,.js",
    "lint:fix": "eslint -c ../../tooling/eslint-config/index.cjs ../../.storybook --ext .ts,.js --fix --quiet",
    "type-check": "tsc --noEmit",
    "clean": "rimraf storybook-static"
  },
  "dependencies": {
    "@zone/core": "workspace:*",
    "@zone/i18n": "workspace:*",
    "@zone/icons": "workspace:*",
    "@zone/utils": "workspace:*"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.6",
    "@zone/eslint-config": "workspace:*",
    "@zone/tsconfig": "workspace:*",
    "@storybook/addon-a11y": "8.6.14",
    "@storybook/addon-actions": "8.6.14",
    "@storybook/addon-docs": "8.6.14",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/addon-links": "8.6.14",
    "@storybook/addon-viewport": "8.6.14",
    "@storybook/blocks": "8.6.14",
    "@storybook/core": "8.6.14",
    "@storybook/manager-api": "8.6.14",
    "@storybook/test": "8.6.14",
    "@storybook/theming": "8.6.14",
    "@storybook/web-components": "8.6.14",
    "@storybook/web-components-vite": "8.6.14",
    "chromatic": "^13.0.1",
    "less": "^4.4.2",
    "lit": "^3.2.1",
    "serve": "^14.2.4",
    "storybook": "8.6.14",
    "typescript": "^5.0.0",
    "vite": "^5.4.11"
  }
}
