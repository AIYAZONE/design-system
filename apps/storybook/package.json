{
  "name": "@aiyazone/storybook",
  "version": "0.1.1",
  "description": "AIYAZONE Design System - Storybook Documentation",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "storybook dev -p 6006 -c ../../.storybook",
    "storybook": "pnpm run dev",
    "build": "storybook build -c ../../.storybook",
    "build:storybook": "pnpm run build",
    "preview": "serve ./storybook-static",
    "test:storybook": "concurrently -k -s first -n \"SERVER,TEST\" \"serve storybook-static -l 6006 --no-clipboard\" \"wait-on tcp:127.0.0.1:6006 && test-storybook --index-json --config-dir ../../.storybook\"",
    "chromatic": "chromatic",
    "lint": "eslint -c ../../tooling/eslint-config/index.cjs ../../.storybook --ext .ts,.js --quiet",
    "lint:verbose": "eslint -c ../../tooling/eslint-config/index.cjs ../../.storybook --ext .ts,.js",
    "lint:fix": "eslint -c ../../tooling/eslint-config/index.cjs ../../.storybook --ext .ts,.js --fix --quiet",
    "type-check": "tsc --noEmit",
    "clean": "rimraf storybook-static"
  },
  "dependencies": {
    "@aiyazone/core": "workspace:*",
    "@aiyazone/i18n": "workspace:*",
    "@aiyazone/icons": "workspace:*",
    "@aiyazone/utils": "workspace:*"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.4",
    "@aiyazone/eslint-config": "workspace:*",
    "@aiyazone/tsconfig": "workspace:*",
    "@storybook/addon-a11y": "^9.1.21",
    "@storybook/addon-docs": "^9.1.21",
    "@storybook/web-components": "^9.1.21",
    "@storybook/web-components-vite": "^9.1.21",
    "chromatic": "^13.0.1",
    "concurrently": "^9.2.1",
    "less": "^4.4.2",
    "lit": "^3.2.1",
    "serve": "^14.2.4",
    "storybook": "^9.1.21",
    "typescript": "^5.0.0",
    "vite": "^7.2.2",
    "wait-on": "^9.0.3",
    "@storybook/test-runner": "0.23.0"
  }
}
