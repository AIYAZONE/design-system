{
  "extends": "@aiyazone/tsconfig/app.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "moduleResolution": "bundler",
    "paths": {
      "@aiyazone/core": ["../../packages/core/src"],
      "@aiyazone/core/*": ["../../packages/core/src/*"],
      "@aiyazone/icons": ["../../packages/icons/src"],
      "@aiyazone/icons/*": ["../../packages/icons/src/*"],
      "@aiyazone/i18n": ["../../packages/i18n/src"],
      "@aiyazone/i18n/*": ["../../packages/i18n/src/*"],
      "@aiyazone/utils": ["../../packages/utils/src"],
      "@aiyazone/utils/*": ["../../packages/utils/src/*"],
      "@/*": ["../../packages/icons/src/*"]
    }
  },
  "include": [
    ".storybook/**/*",
    "stories/**/*",
    "../../src/types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "storybook-static"
  ]
}
